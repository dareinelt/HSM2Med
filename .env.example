# Kopieren nach .env und Passwoerter aendern:  cp .env.example .env

# --- Datenbank -------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hsm2med
DB_USERNAME=hsm2med
DB_PASSWORD=bitte-aendern-app-passwort
# Nur fuer den MySQL-Container (Initialisierung, Backups)
DB_ROOT_PASSWORD=bitte-aendern-root-passwort

# --- Anwendung -------------------------------------------------------------
# production | development | testing
APP_ENV=production
APP_TIMEZONE=Europe/Berlin
# Maximale Upload-Groesse (Bytes oder mit Suffix K/M/G)
UPLOAD_MAX_SIZE=5M
# Rohdaten-Anhang im PDF standardmaessig aktivieren (0/1)
PDF_RAW_APPENDIX_DEFAULT=0
# Session-Cookie nur ueber HTTPS senden (1, wenn ein TLS-Reverse-Proxy vorgeschaltet ist)
SESSION_SECURE_COOKIE=0

# --- Docker ----------------------------------------------------------------
# Host-Adresse und Port der Weboberflaeche. Standard: nur lokal erreichbar.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
